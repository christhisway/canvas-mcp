{
  "name": "canvas-mcp",
  "version": "0.2.0",
  "description": "Personal read-only Canvas LMS MCP connector, OAuth via Microsoft sign-in",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "dev": "tsx watch src/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "revoke-grants": "node dist/revoke-grants.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "html-to-text": "^10.0.1",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
