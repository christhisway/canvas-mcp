# Copy to .env on the machine that runs the server. Never commit .env.

# --- Canvas ---
# Your school's Canvas address (the one in your browser when you're logged in), no /api/v1
CANVAS_BASE_URL=https://yourschool.instructure.com
# Canvas → Account → Settings → "+ New Access Token". Treat it like a password.
CANVAS_TOKEN=

# --- Where Claude reaches this server ---
# Public https origin of the tunnel in front of the server (no path). Also the OAuth issuer.
# For local dev: http://localhost:8787
PUBLIC_URL=https://canvas.example.com
HOST=127.0.0.1
PORT=8787

# --- Sign-in (same Azure app registration as the To Do connector) ---
# Add <PUBLIC_URL>/callback as a Web redirect URI on that app. http://localhost:8787/callback is
# already there for local dev. Prefer a separate client secret for this server so each can be rotated alone.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=replace-me
MS_TENANT=common
# Comma-separated Microsoft account emails allowed to connect. Empty means nobody can.
ALLOWED_EMAILS=you@outlook.com
# Signs the "remember consent" cookie. openssl rand -hex 32
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Hosts whose Client ID Metadata Documents are accepted (claude.ai identifies itself this way).
# "none" switches CIMD off, so clients fall back to dynamic client registration.
# CIMD_ALLOWED_HOSTS=claude.ai
# OAuth clients and grants (token hashes only) are kept here
# DATA_DIR=./data

# --- Submission approval ---
# Where approval codes go. Use a long, unguessable topic (or a self-hosted ntfy).
# Install the ntfy app on your phone and subscribe to the same topic.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# NTFY_TOKEN=            # only if your ntfy topic requires an access token
# APPROVAL_TTL_MINUTES=15

# Only files in this folder can be submitted. An iCloud Drive folder lets you add files from your phone:
# SUBMISSIONS_DIR=/Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/Canvas Submissions
SUBMISSIONS_DIR=./submissions

TIME_ZONE=America/New_York
